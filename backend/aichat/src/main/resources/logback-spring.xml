<?xml version="1.0" encoding="UTF-8"?>
<!--
  日志配置（logback-spring.xml）
  ============================
  架构：
    - console：彩色控制台输出（开发/生产统一）
    - app-file：主滚动文件 logs/app.log，按天 + 单文件 10MB 切割，保留 30 天
    - error-file：ERROR 独立文件 logs/error.log，按天 + 50MB 切割，保留 60 天
    - search-file：搜索引擎专用 logs/search-service.log（保留原 SearchLogger 输出位置）

  Profile：
    - dev（默认）：root=DEBUG，业务包 DEBUG
    - prod：root=INFO，业务包 INFO

  说明：
    - Spring Boot 的 logging.level.* 仍可通过 application.yml 覆盖单 logger 级别
    - 不在此处重复定义 application.yml 中已有的 SearchLogger/WebSearchServiceImpl 等级别
-->
<configuration scan="true" scanPeriod="60 seconds">

    <!-- 公共变量 -->
    <property name="LOG_PATTERN"
              value="%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n"/>
    <property name="LOG_DIR" value="logs"/>
    <property name="MAX_HISTORY" value="30"/>
    <property name="TOTAL_SIZE_CAP" value="5GB"/>

    <!-- 彩色控制台（开发友好，生产也保留，由容器/日志采集器去色） -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %highlight(%-5level) %cyan(%logger{36}) - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- 主滚动文件：app.log -->
    <appender name="APP_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/app.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/app.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>10MB</maxFileSize>
            <maxHistory>${MAX_HISTORY}</maxHistory>
            <totalSizeCap>${TOTAL_SIZE_CAP}</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
        </encoder>
    </appender>

    <!-- ERROR 独立文件：error.log（只收 ERROR） -->
    <appender name="ERROR_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/error.log</file>
        <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
            <level>ERROR</level>
        </filter>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/error.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>50MB</maxFileSize>
            <maxHistory>60</maxHistory>
            <totalSizeCap>2GB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
        </encoder>
    </appender>

    <!-- 搜索引擎专用日志（保留原 search-service.log 路径） -->
    <appender name="SEARCH_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/search-service.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/search-service.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>10MB</maxFileSize>
            <maxHistory>${MAX_HISTORY}</maxHistory>
            <totalSizeCap>1GB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
        </encoder>
    </appender>

    <!-- SearchLogger 路由到 search-service.log（不向 root 冒泡，避免重复） -->
    <logger name="com.example.aichat.config.SearchLogger" level="DEBUG" additivity="false">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="SEARCH_FILE"/>
    </logger>

    <!-- Web 请求日志切面专用 logger（独立标记，便于采集） -->
    <logger name="com.example.aichat.common.web.RequestLogAspect" level="INFO" additivity="false">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="APP_FILE"/>
        <appender-ref ref="ERROR_FILE"/>
    </logger>

    <!-- 第三方依赖降噪 -->
    <logger name="org.springframework" level="INFO"/>
    <logger name="org.mybatis" level="INFO"/>
    <logger name="com.zaxxer.hikari" level="INFO"/>
    <logger name="org.apache.http" level="WARN"/>
    <logger name="io.netty" level="WARN"/>
    <logger name="org.hibernate" level="WARN"/>

    <!-- dev profile：DEBUG 级别 -->
    <springProfile name="dev,default">
        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
            <appender-ref ref="APP_FILE"/>
            <appender-ref ref="ERROR_FILE"/>
        </root>
        <logger name="com.example.aichat" level="DEBUG"/>
    </springProfile>

    <!-- prod profile：INFO 级别 -->
    <springProfile name="prod">
        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
            <appender-ref ref="APP_FILE"/>
            <appender-ref ref="ERROR_FILE"/>
        </root>
        <logger name="com.example.aichat" level="INFO"/>
    </springProfile>

    <!-- test profile：降噪，避免测试日志爆炸 -->
    <springProfile name="test">
        <root level="WARN">
            <appender-ref ref="CONSOLE"/>
        </root>
        <logger name="com.example.aichat" level="WARN"/>
    </springProfile>

</configuration>
