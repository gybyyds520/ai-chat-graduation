# =====================================================================
# AI Chat 环境变量样例文件 - 复制为 .env 后按需修改
# =====================================================================

# 数据库配置
# 注意：以下密码为本地开发默认值，部署到生产环境前务必修改为强密码，
# 并同步设置 JWT_SECRET_KEY（≥32字节随机值，否则 JWT 密钥每次重启都会变化）
DB_USERNAME=aichat
DB_PASSWORD=aichat_2026
DB_PORT=3306

# JWT 签名密钥（生产必须设置，例如：openssl rand -base64 48）
# JWT_SECRET_KEY=

# Redis 配置
REDIS_PORT=6379
REDIS_PASSWORD=

# 应用端口
SERVER_PORT=8080

# CORS 允许来源（逗号分隔，生产环境改为你的前端域名）
# 前端 Vite 开发端口为 5187（见 frontend/vite.config.js），本地调试建议保留该来源
# CORS_ALLOWED_ORIGINS=http://localhost:5187,http://localhost:5173,http://localhost:8080

# AI 服务 API Key
OPENAI_API_KEY=
IMAGE_PROVIDER=disabled
STT_PROVIDER=disabled
TTS_PROVIDER=disabled

# 监控（Grafana）- 生产环境务必修改默认密码
GRAFANA_PASSWORD=admin
